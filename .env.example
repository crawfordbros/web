# Key names and instructions only. Never put real values or secrets in this template.
# Add local values in .env.local and production values in Render's Environment settings.

# Add the existing widget's public Turnstile site key in .env.local and Render.
# VITE_* values are exposed to the browser. The matching secret belongs in the API's TURNSTILE_SECRET_KEY.
# Leave empty only when intentionally disabling the widget for local development.
VITE_TURNSTILE_SITE_KEY=
